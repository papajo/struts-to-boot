<settings>
  <mirrors>
    <!-- maven.mifos.org no longer resolves. Route it to Central; extras go in m2-overrides. -->
    <mirror>
      <id>mifos-dead-to-central</id>
      <mirrorOf>maven-repository.mifos.org,mifos-releases,mifos-snapshots</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>extras</id>
      <!-- Pentaho omni group: pentaho-* reporting libs, spring-mobile 1.0.0.M3, struts-legacy,
           strutstest, jakarta-oro, yuicompressor plugin. Verified by legacy/check-deps.py. -->
      <repositories>
        <repository>
          <id>pentaho</id>
          <url>https://nexus.pentaho.org/content/groups/omni/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>pentaho-plugins</id>
          <url>https://nexus.pentaho.org/content/groups/omni/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>extras</activeProfile></activeProfiles>
</settings>
